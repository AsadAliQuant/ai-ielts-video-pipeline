# NVIDIA NIM cloud API key -- get one at https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-nim-api-key-here

# Gemini API keys -- comma-separated, one per Google account, tried in order.
# Get one at https://aistudio.google.com/apikey
# Used as the automatic fallback when --provider nvidia fails, and directly
# when running with --provider gemini. Rotates to the next key if one hits
# a rate limit.
GEMINI_API_KEYS=key-from-account-1,key-from-account-2

# Fish Audio API key for TTS audio generation (generate_audio.py)
# Get one at https://fish.audio — S2.1 Pro is free for developers until 31 Aug 2026
FISH_AUDIO=your-fish-audio-api-key-here

# Cloudflare Workers AI (FLUX-1-schnell) for Stage 1 visuals -- optional,
# falls back to a Pillow-drawn card if missing.
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token

# YouTube Data API v3 -- used by youtube_upload.py to auto-publish the
# rendered video. Create an OAuth "Desktop app" client at
# https://console.cloud.google.com/apis/credentials (enable "YouTube Data
# API v3" on the project first), then run `python get_youtube_token.py`
# once locally to mint the refresh token below.
YOUTUBE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-oauth-client-secret
YOUTUBE_REFRESH_TOKEN=filled-in-by-get_youtube_token.py
# public | unlisted | private -- start with unlisted until you trust the pipeline
YOUTUBE_PRIVACY=unlisted

# publish_test.py -- pushes a finished test dir to the SaaS pool (D1 + R2).
# CF_ACCOUNT_ID / CF_API_TOKEN above are reused for the D1 HTTP API.
# R2's S3-compatible API needs its own SigV4 keys (Cloudflare dashboard ->
# R2 -> Manage API tokens -> Create API token), NOT the CF_API_TOKEN bearer
# token used for the regular Cloudflare API.
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ielts-listening-media
CF_D1_DATABASE_ID=your-d1-database-id
