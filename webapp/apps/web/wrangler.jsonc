{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ielts-listening-webapp",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ielts-listening",
      "database_id": "141a8b25-4232-4fe8-a0f2-051433b19b5e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ielts-listening-media"
    }
  ]
}
