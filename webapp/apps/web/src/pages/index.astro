---
import "@workspace/ui/globals.css"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>IELTS Listening Practice</title>
  </head>
  <body>
    <main class="flex min-h-svh flex-col items-center justify-center gap-6 p-6 text-center">
      <h1 class="text-3xl font-semibold">IELTS Listening Practice</h1>
      <p class="max-w-md text-muted-foreground">
        Free, computer-based IELTS Listening practice tests. Audio plays once, uninterrupted,
        just like the real exam — type your answers as you listen and get graded instantly.
      </p>
      <a
        href="/practice"
        class="inline-flex h-9 items-center justify-center rounded-2xl bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/80"
      >
        Start practicing
      </a>
    </main>
  </body>
</html>
