---
import "@workspace/ui/globals.css"
import { env } from "cloudflare:workers"

const { slug } = Astro.params
const test = await env.DB
  .prepare(`SELECT title, target_band, context FROM tests WHERE slug = ? AND status = 'published'`)
  .bind(slug)
  .first<{ title: string; target_band: string; context: string }>()

if (!test) {
  return Astro.redirect("/practice")
}

// verbatim from generate_test.py's STUDENT_INSTRUCTIONS (line 62)
const instructions = [
  "You will hear four recordings.",
  "You will have time to read the questions before each recording.",
  "You will hear each recording only once.",
  "Write your answers as you listen.",
  "At the end of the test, check your answers.",
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{test.title} — Instructions</title>
  </head>
  <body>
    <main class="mx-auto max-w-lg space-y-8 p-6">
      <div>
        <h1 class="text-2xl font-semibold">{test.title}</h1>
        <p class="text-muted-foreground">Target band {test.target_band}</p>
      </div>

      <section class="space-y-2">
        <h2 class="font-medium">Instructions</h2>
        <div class="space-y-3 text-sm">
          {instructions.map((line) => <p>{line}</p>)}
        </div>
        <p class="text-sm text-muted-foreground">
          Time: approximately 30 minutes. Questions: 40. Marks: 40.
        </p>
      </section>

      <section class="space-y-2 rounded-lg border p-4">
        <h2 class="font-medium">Sound check</h2>
        <p class="text-sm text-muted-foreground">
          Put your headphones on and confirm you can hear the tone clearly before you start.
        </p>
        <button
          id="sound-check"
          type="button"
          class="inline-flex h-8 items-center justify-center rounded-2xl border px-3 text-sm hover:bg-muted"
        >
          Play test tone
        </button>
      </section>

      <a
        href={`/practice/${slug}/exam`}
        class="inline-flex h-9 w-full items-center justify-center rounded-2xl bg-primary text-sm font-medium text-primary-foreground hover:bg-primary/80"
      >
        Start test
      </a>
      <p class="text-center text-xs text-muted-foreground">
        Once started, the recording plays once with no pause, seek, or replay — just like the
        real exam.
      </p>
    </main>

    <script>
      document.getElementById("sound-check")?.addEventListener("click", () => {
        const ctx = new AudioContext()
        const osc = ctx.createOscillator()
        const gain = ctx.createGain()
        osc.frequency.value = 440
        gain.gain.value = 0.15
        osc.connect(gain).connect(ctx.destination)
        osc.start()
        osc.stop(ctx.currentTime + 0.8)
        osc.onended = () => ctx.close()
      })
    </script>
  </body>
</html>
