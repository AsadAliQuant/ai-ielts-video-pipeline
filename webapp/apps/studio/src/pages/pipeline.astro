---
import Layout from "@/layouts/Layout.astro"
import { PipelineForm } from "@/components/studio/PipelineForm"
import { LiveTerminal } from "@/components/studio/LiveTerminal"
---

<Layout title="Pipeline Runner | IELTS Video Studio">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-extrabold tracking-tight">IELTS Video Pipeline Runner</h1>
      <p class="text-xs text-muted-foreground mt-1">
        Configure generation settings, launch the pipeline, and monitor real-time execution logs.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      {/* Configuration Form Column */}
      <div class="lg:col-span-5 space-y-6">
        <PipelineForm client:load />
      </div>

      {/* Live Terminal & Visual Modal Column */}
      <div class="lg:col-span-7 space-y-6">
        <LiveTerminal client:load />
      </div>
    </div>
  </div>
</Layout>
